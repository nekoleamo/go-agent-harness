# 构建产物
/bin/
/dist/
/dist-desktop/
/gah

# codegraph 本地索引(MCP 知识图谱,不随仓库)
.codegraph/

# 会话日志与运行时数据(home 由 GAH_HOME 定位,仓库内不留)
/sessions/
*.jsonl

# 编辑器
.DS_Store
.idea/
.vscode/

# M7 前端产物与依赖(web-src 工程本地;产物必须存在供 go:embed,但不由 git 托管版本)
/web/dist/
/web-src/node_modules/
# 示例 UI 插件(M7.2)本地构建依赖
/web-src/examples/**/node_modules/
/gah-data
# 运行期配置备份(生效配置同目录 config-backups/;仓库 config/ 为样板目录,备份不入库)
/config/config-backups/
# 覆盖率 profile(CI 由 go test -coverprofile 生成,供覆盖率门复用)
/coverage.out
/sdk-coverage.out

# 桌面壳产物与依赖(desktop/;sidecar 二进制构建产物,构建时由 scripts/gen-desktop.sh 生成)
/desktop/src-tauri/target/
/desktop/src-tauri/binaries/

# 内部设计/推进文档不入库(对外仅保留插件开发规范 PLUGIN_DEV.md;其余随本地开发,不随仓库分发)
/docs/*
!/docs/PLUGIN_DEV.md

# 设计登记册 DESIGN.md(2026-10-01 起):**本地文档,不入库**。
# 它是本项目最大的单文件(数千行)且只对本地开发有意义;对外分发只需要 README、
# docs/PLUGIN_DEV.md 与提交历史。
# 注意:.goreleaser.yaml 的 archives.files 已同步移除它(留在那里会让发版找不到文件而失败),
# README 双语里指向它的超链接也已改成纯文字说明。
# 想恢复跟踪:git add -f DESIGN.md(并删掉本节)
/DESIGN.md

# —— 构建产物:不入库(2026-10-01)——
#
# ① 外部插件各平台产物 internal/embed/extplugins/(约 60M,占原仓库 87%)
#    它是 `scripts/gen-extplugins.sh` 的产物(外部插件独立二进制 + gzip -9 -n),
#    而 CI 的三个 job 都会**先重建**再构建(ci.yml),发版 before hooks 同样重建
#    (docs/RELEASE.md「真发行要求干净工作树」一节)—— 入库它只会让每次 diff
#    都拖着几十兆二进制。
#    代价(**必须知道**):`//go:embed extplugins/<平台>` 要求目录存在,全新 clone
#    后第一次编译前要跑 `bash scripts/gen-extplugins.sh`,否则 go build 直接报
#    "pattern ...: no matching files found"。这与既有的 gen-web.sh 约定一致。
# ② Tauri 编译期生成的 schema(desktop/src-tauri/gen/,约 300K)
#    由 build.rs 里的 `tauri_build::build()` 每次 cargo 编译时重新生成
#    (capability / ACL schema 都是它的产物),入库只会与插件版本打架。
#
# 恢复跟踪:git add -f internal/embed/extplugins desktop/src-tauri/gen
/internal/embed/extplugins/
/desktop/src-tauri/gen/
