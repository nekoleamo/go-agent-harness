# 构建产物
/bin/
/dist/
/gah

# codegraph 本地索引(MCP 知识图谱,不随仓库)
.codegraph/

# 会话日志与运行时数据(home 由 GAH_HOME 定位,仓库内不留)
/sessions/
*.jsonl

# 编辑器
.DS_Store
.idea/
.vscode/

# M7 前端产物与依赖(web-src 工程本地;产物必须存在供 go:embed,但不由 git 托管版本)
/web/dist/
/web-src/node_modules/
# 示例 UI 插件(M7.2)本地构建依赖
/web-src/examples/**/node_modules/
/gah-data
# 运行期配置备份(生效配置同目录 config-backups/;仓库 config/ 为样板目录,备份不入库)
/config/config-backups/
# 覆盖率 profile(CI 由 go test -coverprofile 生成,供覆盖率门复用)
/coverage.out
/sdk-coverage.out

# 桌面壳产物与依赖(desktop/;sidecar 二进制构建产物,构建时由 scripts/gen-desktop.sh 生成)
/desktop/src-tauri/target/
/desktop/src-tauri/binaries/

# 内部设计/推进文档不入库(对外仅保留插件开发规范 PLUGIN_DEV.md;其余随本地开发,不随仓库分发)
/docs/*
!/docs/PLUGIN_DEV.md
