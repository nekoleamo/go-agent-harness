{
  "name": "gah-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "gah Web UI 前端(Vue3 + Vite + TS;M7)。产物 web/dist 由 scripts/gen-web.sh 构建并 embed 进主二进制,运行时严格零构建。",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsgo --noEmit && vite build",
    "typecheck": "vue-tsgo --noEmit",
    "test": "node --test src/*.test.ts",
    "test:layout": "node --test test/layout.test.mjs",
    "test:perf": "node --test test/perf.test.mjs",
    "test:interaction": "node --test test/interaction.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vue-tsgo": "^0.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
